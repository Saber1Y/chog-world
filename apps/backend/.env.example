# Copy to .env. Never commit .env: it holds the keeper key.

# 143 = Monad mainnet, 10143 = Monad testnet (also used for local anvil forks).
CHAIN_ID=10143
RPC_URL=http://127.0.0.1:8545
# Local or unpublished deployments; leave unset to use the shared deployment registry.
DEPLOYMENT_JSON=../../contracts/deployments/local.json

# The only key allowed to call ChogOperator. Fund it with MON for gas and nothing else.
# For scripts/local-world.mjs this is anvil's public development account #1.
KEEPER_PRIVATE_KEY=
# Optional separate key for resolving quests and battles (no privileges needed).
RESOLVER_PRIVATE_KEY=

# Unset = embedded PGlite under PGLITE_DIR (development only).
DATABASE_URL=
PGLITE_DIR=./.data/chogworld

# Language models that decide and narrate, tried in this order; each is used only when its key is set.
# With none set (or AGENT_LLM_ENABLED=false) the agent uses the heuristic decider and templated digests.
AGENT_LLM_ENABLED=false
LLM_PROVIDERS=gemini,openrouter,claude
# Google AI Studio (aistudio.google.com): free tier, OpenAI-compatible endpoint.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# OpenRouter (openrouter.ai): openrouter/free routes to whichever free model is available.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5

AGENT_ENABLED=true
# Demo pacing; 15 is the production default.
TICK_MINUTES=1
# Most moves a Chog makes per day (each costs keeper gas), and how long it waits after resting.
MOVES_PER_DAY=12
REST_MINUTES=60
SCHEDULER_INTERVAL_SEC=15

PORT=9100
# 127.0.0.1 when a reverse proxy on the same host fronts the API.
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3100
