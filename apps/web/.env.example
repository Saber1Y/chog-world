# Backend API (apps/backend).
NEXT_PUBLIC_API_URL=http://localhost:9100
# 143 Monad mainnet, 10143 Monad testnet (also local forks).
NEXT_PUBLIC_CHAIN_ID=10143
# Only for a local anvil fork (scripts/local-world.mjs). Leave unset for real networks.
NEXT_PUBLIC_RPC_URL=
# Mobile wallets via WalletConnect need a project id from cloud.reown.com.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
# Local fork only: adds a "Local test wallet" backed by an anvil development account.
NEXT_PUBLIC_DEV_WALLET=false
