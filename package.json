{
  "name": "chog-world",
  "private": true,
  "packageManager": "pnpm@10.30.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "contracts:test": "cd contracts && forge test",
    "contracts:fork": "cd contracts && forge test --match-path 'test/fork/*'",
    "world:local": "node scripts/local-world.mjs"
  }
}
